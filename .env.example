# AINPC Demo - Configurare Docker
# Copiaza acest fisier ca .env si ajusteaza valorile

# Server
MEMORY=2G
DIFFICULTY=peaceful
MODE=creative
MAX_PLAYERS=5
VIEW_DISTANCE=8
SIMULATION_DISTANCE=8
MOTD=AINPC Demo - SAT DEMO

# RCON
ENABLE_RCON=TRUE
RCON_PASSWORD=demo
RCON_PORT=25575

# Jucator implicit pentru smoke test
PLAYER_NAME=Hero
REGION_ID=demo_sat
